# Server-side only. Copy to an ignored .env.local file and fill on your own machine.
LOCAL_GATEWAY_URL=https://lm-gateway.example.com
LOCAL_GATEWAY_SECRET=
LOCAL_ALLOWED_USER_IDS=your-supabase-auth-user-uuid
LOCAL_ALLOWED_ORIGINS=https://your-chatforme-site.example.com
# Recommended: Cloudflare Access service-token policy, in addition to gateway authentication.
LOCAL_ACCESS_CLIENT_ID=
LOCAL_ACCESS_CLIENT_SECRET=
